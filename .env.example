# ---- Shared ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=smart_school

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=smart_school
POSTGRES_USER=smart_school
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smart_school:change_me_strong_password@postgres:5432/smart_school

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change_me_generate_with_openssl_rand_base64_64
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---- S3-compatible storage (MinIO locally) ---------------------------------
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=smart-school-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# ---- AI provider (optional) ------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---- Notification providers (optional) -------------------------------------
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Smart School Manager
